<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ReflectionAudit</AssemblyName>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <DefineConstants>$(DefineConstants);$(Variant);$(Variant2)</DefineConstants>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <!--
      The emitter and the A/B input classes are MinimalEmitter's, compiled in unchanged, so this
      harness and the builder comparison are driven by exactly the same emit sequence. Default
      compile items are off so MinimalEmitter's own Program.cs is not pulled in as a second entry
      point.
  -->
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\MinimalEmitter\Emitter.cs" />
    <Compile Include="..\MinimalEmitter\Inputs.cs" />
  </ItemGroup>
</Project>
